# ─────────────────────────────────────────────────────────────
# Client (copy to client/.env)
# ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4001

# ─────────────────────────────────────────────────────────────
# Server (copy to server/.env)
# ─────────────────────────────────────────────────────────────
PORT=4001
ALLOWED_ORIGIN=http://localhost:5173

# Public-facing site URL — used in the sitemap. Optional.
PUBLIC_SITE_URL=https://softwaresellr.example.com

# MongoDB Atlas — create a database user and replace below.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/softwaresellr

# Admin login (used by /admin) — set both. Email is case-insensitive.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-strong-password

# Random 48+ byte string used to sign admin JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-random-secret

# ─────────────────────────────────────────────────────────────
# SMTP — used to email the admin when a new WhatsApp order fires.
# All four required to enable; if any is missing, emails are
# logged to stdout instead of sent. For Gmail use an "App password"
# (https://myaccount.google.com/apppasswords) — your normal Google
# password won't work for SMTP since 2-step verification was enforced.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
# Defaults to SMTP_USER if unset.
SMTP_FROM=
# Where notifications are delivered. Defaults to ADMIN_EMAIL if unset.
NOTIFY_EMAIL=
